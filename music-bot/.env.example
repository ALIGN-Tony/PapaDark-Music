# Copy this file to .env (or export these variables) before running the bot.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=paste-your-token-here

# The public GitHub repo that holds your MP3s ("owner/repo")
MUSIC_REPO=ALIGN-Tony/College-Checklist

# Branch and folder inside that repo to scan for audio files
MUSIC_BRANCH=main
MUSIC_PATH=music

# Command prefix in Discord chat
COMMAND_PREFIX=!

# Optional: where the web player lives (posted by !listen). If unset, it is
# derived from MUSIC_REPO as https://<owner>.github.io/<repo>/player/
#PLAYER_URL=
