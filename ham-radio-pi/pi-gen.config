# pi-gen configuration for the HamPi field image.
# Copied next to pi-gen as 'config' by build.sh / the GitHub Actions workflow.

IMG_NAME=HamPi
RELEASE=bookworm
ARCH=arm64

TARGET_HOSTNAME=hampi
FIRST_USER_NAME=hamop
# CHANGE THIS before building, or set FIRST_USER_PASS in the environment.
FIRST_USER_PASS=${FIRST_USER_PASS:-hampi-field}
DISABLE_FIRST_BOOT_USER_RENAME=1

ENABLE_SSH=1
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=UTC

# stage2 = Raspberry Pi OS with desktop (needed for WSJT-X, CHIRP, Xastir GUIs)
STAGE_LIST="stage0 stage1 stage2 ./stage-ham"

DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
