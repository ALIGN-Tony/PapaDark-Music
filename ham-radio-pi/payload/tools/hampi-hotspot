#!/bin/bash
#
# HamPi Wi-Fi hotspot: lets a phone join the Pi and open the dashboard at
# http://10.42.0.1:8073 with no other network around. Uses NetworkManager
# (standard on Raspberry Pi OS Bookworm).
#
#   hampi-hotspot up [SSID] [PASSWORD]    default: HamPi / hampifield
#   hampi-hotspot down
#   hampi-hotspot status

set -u

CON=hampi-hotspot
SSID="${2:-HamPi}"
PASS="${3:-hampifield}"

if [ "$(id -u)" -ne 0 ] && [ "${1:-}" != "status" ]; then
    exec sudo "$0" "$@"
fi
command -v nmcli >/dev/null || { echo "NetworkManager (nmcli) not found." >&2; exit 1; }

case "${1:-}" in
    up)
        if [ ${#PASS} -lt 8 ]; then
            echo "Password must be at least 8 characters." >&2; exit 1
        fi
        nmcli connection delete "$CON" >/dev/null 2>&1
        nmcli device wifi hotspot ifname wlan0 con-name "$CON" \
            ssid "$SSID" password "$PASS" || exit 1
        echo
        echo "Hotspot up.  On your phone:"
        echo "  1. Join Wi-Fi network '$SSID' (password: $PASS)"
        echo "  2. Open   http://10.42.0.1:8073"
        [ "$PASS" = "hampifield" ] && echo "  (Default password - set your own: hampi-hotspot up $SSID YourPassword)"
        ;;
    down)
        nmcli connection down "$CON" 2>/dev/null
        nmcli connection delete "$CON" >/dev/null 2>&1
        echo "Hotspot stopped; normal Wi-Fi client mode restored."
        ;;
    status)
        if nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx "$CON"; then
            echo "Hotspot ACTIVE - dashboard at http://10.42.0.1:8073"
        else
            echo "Hotspot not running.  Start: hampi-hotspot up"
        fi
        ;;
    *)
        sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
