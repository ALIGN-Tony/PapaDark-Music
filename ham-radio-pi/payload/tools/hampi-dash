# ---------------------------------------------------------------------------
# Spectrum scan (rtl_power)
# ---------------------------------------------------------------------------

_scan_lock = threading.Lock()


@app.get("/api/scan")
def api_scan():
    if not shutil.which("rtl_power"):
        return err("rtl_power not installed")
    rng = request.args.get("range", "144M:148M")
    if not re.fullmatch(r"[0-9.]+[kMG]?:[0-9.]+[kMG]?(:[0-9.]+[kMG]?)?", rng):
        return err("bad range (use e.g. 144M:148M)", 400)
    secs = min(int(request.args.get("secs", 10)), 30)
    if not _scan_lock.acquire(blocking=False):
        return err("a scan is already running", 409)
    tmp = None
    try:
        import tempfile
        fd, tmp = tempfile.mkstemp(suffix=".csv")
        os.close(fd)
        res = subprocess.run(["rtl_power", "-f", rng, "-i", "1",
                              "-e", f"{secs}s", tmp],
                             capture_output=True, text=True, timeout=secs + 25)
        if res.returncode != 0:
            return err(f"rtl_power failed: {res.stderr.strip()[-200:]}")
        best = {}
        with open(tmp) as fh:
            for ln in fh:
                p = [x.strip() for x in ln.split(",")]
                if len(p) < 8:
                    continue
                low, step = float(p[2]), float(p[4])
                for i, v in enumerate(p[6:]):
                    f_mhz = round((low + i * step) / 1e6, 4)
                    dbv = float(v)
                    if f_mhz not in best or dbv > best[f_mhz]:
                        best[f_mhz] = dbv
        freqs = sorted(best)
        stride = max(1, len(freqs) // 500)
        freqs = freqs[::stride]
        dbs = [best[f] for f in freqs]
        top = sorted(best.items(), key=lambda kv: -kv[1])[:10]
        return jsonify({"range": rng, "freqs": freqs, "db": dbs,
                        "top": [[f, d] for f, d in top]})
    except subprocess.TimeoutExpired:
        return err("scan timed out")
    except (OSError, ValueError) as e:
        return err(e)
    finally:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        _scan_lock.release()


# ---------------------------------------------------------------------------
# Live FT8/JS8 spots - UDP listeners for WSJT-X and JS8Call
#
# WSJT-X: Settings -> Reporting -> UDP Server 127.0.0.1:2237 (the default).
#   Binary QDataStream protocol; we parse Decode (2), Status (1) and
#   QSO Logged (5) - a logged QSO is auto-inserted into the HamPi logbook.
# JS8Call: Settings -> Reporting -> Enable UDP API (port 2242). JSON datagrams.
# ---------------------------------------------------------------------------

import collections
import math
import struct

WSJTX_PORT = int(os.environ.get("HAMPI_WSJTX_PORT", 2237))
JS8_PORT = int(os.environ.get("HAMPI_JS8_PORT", 2242))
WSJTX_MAGIC = 0xADBCCBDA

_spots = collections.deque(maxlen=500)
_spots_lock = threading.Lock()
_spot_seq = 0
_unique_calls = set()
_listeners = {}          # name -> {"ok": bool, "last": ts, "error": str}
_wsjtx_status = {}       # last Status message fields

BANDS_HZ = [(1.8e6, 2.0e6, "160m"), (3.5e6, 4.0e6, "80m"), (5.2e6, 5.5e6, "60m"),
            (7.0e6, 7.3e6, "40m"), (10.1e6, 10.15e6, "30m"), (14.0e6, 14.35e6, "20m"),
            (18.068e6, 18.168e6, "17m"), (21.0e6, 21.45e6, "15m"),
            (24.89e6, 24.99e6, "12m"), (28.0e6, 29.7e6, "10m"),
            (50e6, 54e6, "6m"), (144e6, 148e6, "2m"), (420e6, 450e6, "70cm")]


def band_name(hz):
    for lo, hi, name in BANDS_HZ:
        if lo <= hz <= hi:
            return name
    return f"{hz / 1e6:.3f}M" if hz else "?"


class QReader:
    """Minimal big-endian QDataStream reader for the WSJT-X protocol."""

    def __init__(self, data):
        self.b, self.i = data, 0

    def _take(self, fmt, size):
        v = struct.unpack_from(fmt, self.b, self.i)[0]
        self.i += size
        return v

    def u8(self): return self._take(">B", 1)
    def boolean(self): return self._take(">B", 1) != 0
    def u32(self): return self._take(">I", 4)
    def i32(self): return self._take(">i", 4)
    def u64(self): return self._take(">Q", 8)
    def i64(self): return self._take(">q", 8)
    def f64(self): return self._take(">d", 8)

    def utf8(self):
        n = self.u32()
        if n == 0xFFFFFFFF:
            return ""
        s = self.b[self.i:self.i + n].decode("utf-8", "replace")
        self.i += n
        return s

    def qdatetime(self):
        """-> unix seconds (UTC-ish; WSJT-X sends spec 1 = UTC)."""
        jd = self.i64()
        ms = self.u32()
        spec = self.u8()
        if spec == 2:
            self.i32()  # utc offset, unused
        return (jd - 2440588) * 86400 + ms / 1000.0


CALL_RE = re.compile(r"^[A-Z0-9]{1,3}[0-9][A-Z0-9]*[A-Z](/[A-Z0-9]+)?$|"
                     r"^[A-Z0-9]+/[A-Z0-9]{1,3}[0-9][A-Z0-9]*[A-Z]$")
GRID_RE = re.compile(r"^[A-R]{2}[0-9]{2}([A-X]{2})?$")


def parse_ft8_text(msg):
    """Extract (caller, grid, is_cq) from an FT8/FT4 message payload."""
    toks = msg.replace("<", "").replace(">", "").upper().split()
    if not toks:
        return None, None, False
    grid = toks[-1] if GRID_RE.match(toks[-1]) and toks[-1] != "RR73" else None
    if toks[0] == "CQ":
        # CQ [DX|POTA|TEST...] CALL [GRID]
        for t in toks[1:]:
            if CALL_RE.match(t):
                return t, grid, True
        return None, grid, True
    if len(toks) >= 2 and CALL_RE.match(toks[1]):
        return toks[1], grid, False   # "TOCALL FROMCALL payload"
    return None, grid, False


def bearing_km(grid_from, grid_to):
    try:
        ant = load_tool("hampi-antenna")
        lat1, lon1 = ant.grid_to_latlon(grid_from)
        lat2, lon2 = ant.grid_to_latlon(grid_to)
    except Exception:
        return None, None
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    az = (math.degrees(math.atan2(y, x)) + 360) % 360
    km = 6371 * math.acos(max(-1, min(1, math.sin(p1) * math.sin(p2)
                                      + math.cos(p1) * math.cos(p2) * math.cos(dl))))
    return round(az), round(km)


def my_grid():
    try:
        g = load_tool("hampi-antenna").station_grid()
    except Exception:
        g = None
    return g or _wsjtx_status.get("de_grid") or None


def add_spot(source, utc, snr, df, mode, msg, dial_hz):
    global _spot_seq
    call, grid, is_cq = parse_ft8_text(msg)
    az = km = None
    origin = my_grid()
    if grid and origin:
        az, km = bearing_km(origin, grid)
    with _spots_lock:
        _spot_seq += 1
        if call:
            _unique_calls.add(call)
        _spots.append({"seq": _spot_seq, "src": source, "utc": utc, "snr": snr,
                       "df": df, "mode": mode, "msg": msg.strip(), "call": call,
                       "grid": grid, "cq": is_cq, "az": az, "km": km,
                       "band": band_name(dial_hz), "ts": time.time()})


def autolog_qso(q):
    """A QSO the operator logged in WSJT-X lands in the HamPi logbook too."""
    try:
        conn = db()
        ts = datetime.fromtimestamp(q["time_off"], timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
        conn.execute(
            "INSERT INTO qsos (ts_utc,call,freq_mhz,mode,rst_sent,rst_rcvd,name,qth,grid,notes)"
            " VALUES (?,?,?,?,?,?,?,?,?,?)",
            (ts, q["dx_call"].upper(), round(q["freq_hz"] / 1e6, 4), q["mode"].upper(),
             q["rst_sent"], q["rst_rcvd"], q["name"], "", q["dx_grid"].upper(),
             ("via WSJT-X. " + q["comments"]).strip()))
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"autolog failed: {e}", flush=True)


def handle_wsjtx(data):
    r = QReader(data)
    if r.u32() != WSJTX_MAGIC:
        return
    r.u32()          # schema
    mtype = r.u32()
    r.utf8()         # client id
    if mtype == 2:   # Decode
        r.boolean()  # new
        ms = r.u32()
        utc = f"{ms // 3600000:02d}:{ms % 3600000 // 60000:02d}:{ms % 60000 // 1000:02d}"
        snr = r.i32()
        r.f64()      # delta time
        df = r.u32()
        mode = r.utf8()
        msg = r.utf8()
        add_spot("wsjtx", utc, snr, df, mode or _wsjtx_status.get("mode", ""),
                 msg, _wsjtx_status.get("dial_hz", 0))
    elif mtype == 1:  # Status
        _wsjtx_status.update({
            "dial_hz": r.u64(), "mode": r.utf8(), "dx_call": r.utf8(),
            "report": r.utf8(), "tx_mode": r.utf8(), "tx_enabled": r.boolean(),
            "transmitting": r.boolean(), "decoding": r.boolean(),
            "rx_df": r.u32(), "tx_df": r.u32(), "de_call": r.utf8(),
            "de_grid": r.utf8(), "dx_grid": r.utf8(), "ts": time.time()})
    elif mtype == 5:  # QSO Logged
        q = {"time_off": r.qdatetime(), "dx_call": r.utf8(), "dx_grid": r.utf8(),
             "freq_hz": r.u64(), "mode": r.utf8(), "rst_sent": r.utf8(),
             "rst_rcvd": r.utf8(), "tx_power": r.utf8(), "comments": r.utf8(),
             "name": r.utf8()}
        if q["dx_call"]:
            autolog_qso(q)


def handle_js8(data):
    msg = json.loads(data.decode("utf-8", "replace"))
    mtype = msg.get("type", "")
    p = msg.get("params", {}) or {}
    if mtype in ("RX.DIRECTED", "RX.SPOT", "RX.ACTIVITY"):
        utc = datetime.now(timezone.utc).strftime("%H:%M:%S")
        text = str(msg.get("value") or "").strip()
        if mtype == "RX.SPOT" and not text:
            text = f"{p.get('CALL', '')} {p.get('GRID', '')}".strip()
        if not text:
            return
        add_spot("js8", utc, int(p.get("SNR", 0)), int(p.get("OFFSET", p.get("FREQ", 0)) or 0),
                 "JS8", text, int(p.get("DIAL", 0) or 0))


def udp_listener(name, port, handler):
    info = _listeners[name] = {"ok": False, "last": None, "error": None, "port": port}
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(("0.0.0.0", port))
        info["ok"] = True
    except OSError as e:
        info["error"] = f"port {port} busy ({e}) - another app (GridTracker?) has it"
        return
    while True:
        try:
            data, _ = sock.recvfrom(65535)
            info["last"] = time.time()
            handler(data)
        except Exception:
            pass  # one malformed datagram must not kill the listener


def start_spot_listeners():
    for name, port, fn in (("wsjtx", WSJTX_PORT, handle_wsjtx),
                           ("js8call", JS8_PORT, handle_js8)):
        threading.Thread(target=udp_listener, args=(name, port, fn),
                         daemon=True, name=f"udp-{name}").start()


@app.get("/api/spots")
def api_spots():
    since = int(request.args.get("since", 0))
    with _spots_lock:
        fresh = [s for s in _spots if s["seq"] > since][-200:]
        n_unique = len(_unique_calls)
    listeners = {}
    now = time.time()
    for name, li in _listeners.items():
        listeners[name] = {"ok": li["ok"], "error": li["error"],
                           "age_s": round(now - li["last"]) if li["last"] else None}
    st = dict(_wsjtx_status)
    if st:
        st["age_s"] = round(now - st.pop("ts", now))
        st["band"] = band_name(st.get("dial_hz", 0))
    return jsonify({"spots": fresh, "unique_calls": n_unique,
                    "status": st, "listeners": listeners, "my_grid": my_grid()})


# ---------------------------------------------------------------------------
# NanoVNA antenna analyzer
#
# Talks to a NanoVNA over its USB serial console, runs an S11 (reflection)
# sweep, and turns it into SWR, return loss, feedpoint impedance, resonant
# frequency, and 2:1 bandwidth. The frontend pairs this with the antenna
# calculator: sweep -> see resonance -> trim to target.
# ---------------------------------------------------------------------------

import glob
import math

VNA_BAUD = 115200


def vna_ports():
    return sorted(glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*"))


def _vna_talk(ser, cmd, timeout=20):
    """Send a command, read until the NanoVNA's 'ch>' prompt, return lines."""
    ser.reset_input_buffer()
    ser.write((cmd + "\r\n").encode())
    buf, end = b"", time.time() + timeout
    while time.time() < end:
        chunk = ser.read(4096)
        if chunk:
            buf += chunk
            if buf.rstrip().endswith(b"ch>"):
                break
        elif buf:
            break
    lines = buf.decode("ascii", "replace").replace("\r", "").split("\n")
    lines = [ln for ln in lines if ln and not ln.startswith("ch>")]
    if lines and lines[0].strip() == cmd:   # drop the echoed command
        lines = lines[1:]
    return lines


def vna_open(port):
    import serial
    return serial.Serial(port, VNA_BAUD, timeout=1)


def vna_detect():
    """Return the first port that answers the NanoVNA console, or None."""
    try:
        import serial  # noqa: F401
    except ImportError:
        return {"error": "python3-serial not installed"}
    forced = os.environ.get("HAMPI_VNA_PORT")  # override for odd-enumerating clones
    if forced:
        return {"port": forced, "id": forced}
    for port in vna_ports():
        try:
            ser = vna_open(port)
            try:
                out = " ".join(_vna_talk(ser, "version", timeout=3)
                               + _vna_talk(ser, "", timeout=1))
                if "ch>" in out or "NanoVNA" in out or "version" in out.lower() or out.strip():
                    return {"port": port, "id": out.strip()[:80] or port}
            finally:
                ser.close()
        except Exception:
            continue
    return {"port": None}


def vna_sweep(port, start_hz, stop_hz, points):
    ser = vna_open(port)
    pts = []
    try:
        _vna_talk(ser, "pause", timeout=3)
        # Preferred: scan start stop points mask(3 = freq + S11)
        for ln in _vna_talk(ser, f"scan {start_hz} {stop_hz} {points} 3", timeout=30):
            f = ln.split()
            if len(f) >= 3:
                try:
                    pts.append((float(f[0]), float(f[1]), float(f[2])))
                except ValueError:
                    pass
        if not pts:
            # Fallback for firmwares without 'scan': set sweep, read separately.
            _vna_talk(ser, f"sweep {start_hz} {stop_hz} {points}", timeout=10)
            freqs = []
            for ln in _vna_talk(ser, "frequencies", timeout=10):
                try:
                    freqs.append(float(ln.strip()))
                except ValueError:
                    pass
            data = _vna_talk(ser, "data 0", timeout=10)
            for fr, ln in zip(freqs, data):
                p = ln.split()
                if len(p) >= 2:
                    try:
                        pts.append((fr, float(p[0]), float(p[1])))
                    except ValueError:
                        pass
    finally:
        try:
            _vna_talk(ser, "resume", timeout=3)
        except Exception:
            pass
        ser.close()
    return pts


def analyze_sweep(pts):
    """pts: [(freq_hz, s11_re, s11_im)] -> curve + resonance + bandwidth."""
    freqs, swr, rl = [], [], []
    best = None  # (swr, index)
    for i, (fr, re, im) in enumerate(pts):
        g = math.hypot(re, im)
        s = (1 + g) / (1 - g) if g < 0.999 else 99.0
        freqs.append(round(fr / 1e6, 4))
        swr.append(round(s, 3))
        rl.append(round(-20 * math.log10(g), 1) if g > 1e-6 else 99.0)
        if best is None or s < best[0]:
            best = (s, i)

    resonance = None
    if best is not None:
        i = best[1]
        fr, re, im = pts[i]
        denom = (1 - re) ** 2 + im ** 2
        r = 50 * (1 - re * re - im * im) / denom if denom else 0
        x = 50 * (2 * im) / denom if denom else 0
        resonance = {"freq_mhz": round(fr / 1e6, 4), "swr": swr[i],
                     "r": round(r, 1), "x": round(x, 1), "rl_db": rl[i]}

    # 2:1 bandwidth: lowest and highest freq with SWR <= 2.0
    under = [freqs[i] for i, s in enumerate(swr) if s <= 2.0]
    bandwidth = None
    if under:
        bandwidth = {"low_mhz": min(under), "high_mhz": max(under),
                     "span_khz": round((max(under) - min(under)) * 1000)}
    return {"freqs": freqs, "swr": swr, "resonance": resonance, "bandwidth": bandwidth}


@app.get("/api/vna/detect")
def api_vna_detect():
    return jsonify(cached("vna", 5, vna_detect))


@app.get("/api/vna/sweep")
def api_vna_sweep():
    try:
        import serial  # noqa: F401
    except ImportError:
        return err("python3-serial not installed")
    det = vna_detect()
    port = request.args.get("port") or det.get("port")
    if not port:
        return err("No NanoVNA detected. Plug it into USB (it appears as "
                   "/dev/ttyACM0); you must be in the 'dialout' group.")
    try:
        start = float(request.args["start_mhz"]) * 1e6
        stop = float(request.args["stop_mhz"]) * 1e6
    except (KeyError, ValueError):
        return err("start_mhz and stop_mhz are required", 400)
    if not (0 < start < stop <= 3e9) or stop - start < 1000:
        return err("bad sweep range", 400)
    points = max(11, min(int(request.args.get("points", 101)), 401))
    try:
        pts = vna_sweep(port, int(start), int(stop), points)
    except Exception as e:
        return err(f"NanoVNA read failed on {port}: {e}")
    if not pts:
        return err("NanoVNA returned no data (unsupported firmware command set?)")
    res = analyze_sweep(pts)
    res["port"] = port
    res["points"] = len(pts)
    return jsonify(res)


