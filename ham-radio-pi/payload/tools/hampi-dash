# ---------------------------------------------------------------------------
# RF Pi licensing - trial clock + offline Ed25519 license keys
#
# Enforcement is armed only when a vendor public key is installed
# (/etc/hampi/vendor.pub, baked into commercial images by setup.sh).
# Without it the suite runs in "dev" mode with no lock - so the open build
# keeps working for development and personal use.
#
# What locks when a trial expires: the RF Pi suite's own API/UI. What NEVER
# locks: the bundled open-source applications (not ours to lock - see
# /etc/hampi/OPEN-SOURCE.txt) and the operator's own logbook data (reading
# and ADIF export always work).
# ---------------------------------------------------------------------------

import base64

VENDOR_PUB = os.environ.get("HAMPI_VENDOR_PUB", "/etc/hampi/vendor.pub")
VENDOR_CONF = os.environ.get("HAMPI_VENDOR_CONF", "/etc/hampi/vendor.conf")


def _b64d(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def vendor_conf():
    conf = {"PURCHASE_URL": "", "TRIAL_DAYS": "14", "CONTACT": ""}
    try:
        with open(VENDOR_CONF) as fh:
            for line in fh:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


def parse_license(text):
    """Verify an RFPI1 key against the vendor public key.
    Returns the payload dict, or raises ValueError."""
    try:
        raw_pub = base64.b64decode(open(VENDOR_PUB, "rb").read().strip())
    except OSError:
        raise ValueError("no vendor public key installed")
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
        from cryptography.exceptions import InvalidSignature
    except ImportError:
        raise ValueError("python3-cryptography not installed")
    parts = text.strip().split(".")
    if len(parts) != 3 or parts[0] != "RFPI1":
        raise ValueError("malformed key (expected RFPI1.payload.signature)")
    try:
        payload, sig = _b64d(parts[1]), _b64d(parts[2])
        Ed25519PublicKey.from_public_bytes(raw_pub).verify(sig, payload)
        data = json.loads(payload)
    except (InvalidSignature, ValueError, json.JSONDecodeError):
        raise ValueError("invalid license key")
    if data.get("p") != "rfpi" or not data.get("call"):
        raise ValueError("key is not an RF Pi license")
    return data


def _license_paths():
    # User-activated key, then a vendor-baked one (pre-activated SD cards).
    return [os.path.join(DB_DIR, "license.key"), "/etc/hampi/license.key"]


def _trial_anchor():
    path = os.path.join(DB_DIR, "trial.json")
    try:
        return json.load(open(path))["first_run"]
    except (OSError, ValueError, KeyError):
        pass
    first = int(time.time())
    try:
        os.makedirs(DB_DIR, exist_ok=True)
        with open(path, "w") as fh:
            json.dump({"first_run": first}, fh)
    except OSError:
        pass
    return first


def license_status_uncached():
    if not os.path.exists(VENDOR_PUB):
        return {"state": "dev",
                "note": "no vendor key installed - licensing not enforced"}
    for path in _license_paths():
        try:
            data = parse_license(open(path).read())
            return {"state": "licensed", "call": data["call"],
                    "name": data.get("name", ""), "issued": data.get("issued", "")}
        except (OSError, ValueError):
            continue
    conf = vendor_conf()
    try:
        trial_days = max(1, int(conf["TRIAL_DAYS"]))
    except ValueError:
        trial_days = 14
    elapsed_days = (time.time() - _trial_anchor()) / 86400
    left = trial_days - elapsed_days
    base = {"purchase_url": conf["PURCHASE_URL"], "trial_days": trial_days}
    if left > 0:
        return dict(base, state="trial", days_left=max(1, round(left)))
    return dict(base, state="expired")


def license_status():
    return cached("license", 10, license_status_uncached)


@app.get("/api/license")
def api_license_get():
    return jsonify(license_status())


@app.post("/api/license")
def api_license_activate():
    body = request.get_json(silent=True) or {}
    try:
        data = parse_license(str(body.get("key", "")))
    except ValueError as e:
        return err(e, 400)
    os.makedirs(DB_DIR, exist_ok=True)
    with open(os.path.join(DB_DIR, "license.key"), "w") as fh:
        fh.write(str(body.get("key", "")).strip() + "\n")
    with _cache_lock:
        _cache.pop("license", None)
    return jsonify({"ok": True, "call": data["call"], "name": data.get("name", "")})


@app.before_request
def license_gate():
    p = request.path
    if not p.startswith("/api/"):
        return None   # frontend must load to show the lock screen
    if license_status()["state"] != "expired":
        return None
    # Always allowed when expired: activation, status (the lock screen needs
    # both), and the operator's own logbook data - reads and ADIF export.
    # (/api/callsign is NOT here - offline lookup is a licensed feature.)
    if p in ("/api/license", "/api/status", "/api/log/export.adi"):
        return None
    if p == "/api/log" and request.method == "GET":
        return None
    return jsonify({"error": "RF Pi trial expired - enter a license key",
                    "locked": True}), 402


# ---------------------------------------------------------------------------
# Reuse the hampi-* CLI tools as libraries
# ---------------------------------------------------------------------------

_tools = {}


def load_tool(fname):
    if fname in _tools:
        return _tools[fname]
    path = os.path.join(TOOLS_DIR, fname)
    modname = fname.replace("-", "_")
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(modname, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _tools[fname] = mod
    return mod


def capture(fn, *a, **kw):
    """Run a print-style function and return what it printed."""
    buf = io.StringIO()
    with redirect_stdout(buf):
        fn(*a, **kw)
    return buf.getvalue()


def err(msg, code=503):
    return jsonify({"error": str(msg)}), code


# ---------------------------------------------------------------------------
# Cached hardware probes (keep /api/status fast)
# ---------------------------------------------------------------------------

_cache = {}
_cache_lock = threading.Lock()


def cached(key, ttl, fn):
    now = time.monotonic()
    with _cache_lock:
        hit = _cache.get(key)
        if hit and now - hit[0] < ttl:
            return hit[1]
    val = fn()
    with _cache_lock:
        _cache[key] = (now, val)
    return val


def probe_keyboards():
    """Physical (USB/Bluetooth) keyboards currently attached."""
    names = []
    try:
        blocks = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        return names
    for b in blocks:
        if "kbd" not in b:
            continue
        m = re.search(r'N: Name="([^"]+)"', b)
        ev = re.search(r"B: EV=([0-9a-f]+)", b)
        if not (m and ev):
            continue
        evbits = int(ev.group(1), 16)
        name = m.group(1)
        # Real keyboards report key events (0x2) with auto-repeat (0x100000);
        # skip the Pi's own pseudo-devices.
        if evbits & 0x2 and evbits & 0x100000 and not any(
                s in name.lower() for s in ("gpio", "vc4", "hdmi", "virtual")):
            names.append(name)
    return names


def probe_gps():
    if not shutil.which("gpspipe"):
        return {"state": "no-gpsd"}
    try:
        out = subprocess.run(["gpspipe", "-w", "-n", "6"], capture_output=True,
                             text=True, timeout=4).stdout
    except Exception:
        return {"state": "no-fix"}
    for line in out.splitlines():
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        if msg.get("class") == "TPV" and msg.get("mode", 0) >= 2:
            return {"state": "fix", "mode": msg["mode"], "lat": msg.get("lat"),
                    "lon": msg.get("lon"), "alt": msg.get("alt"),
                    "speed": msg.get("speed"), "time": msg.get("time")}
    return {"state": "no-fix"}


def probe_timesync():
    try:
        out = subprocess.run(["timedatectl", "show", "-p", "NTPSynchronized",
                              "--value"], capture_output=True, text=True,
                             timeout=3).stdout.strip()
        return out == "yes"
    except Exception:
        return None


