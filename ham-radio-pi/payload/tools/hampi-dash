#!/usr/bin/env python3
"""HamPi dashboard server.

One web app, two faces:
  - Tablet/RasPad: full-screen touch dashboard with movable, resizable widget
    windows and a built-in on-screen keyboard (auto-disabled the moment a USB
    or Bluetooth keyboard is present).
  - Phone: the same widgets in a stacked mobile layout, reachable over the
    Pi's hotspot (hampi-hotspot up -> http://10.42.0.1:8073).

It reuses the hampi-* CLI tools as libraries (they are imported, not shelled
out to) and adds a station logbook (SQLite + ADIF export) and rigctld bridge.

Runs as a systemd service (hampi-dash.service). Manual start:
    hampi-dash --host 0.0.0.0 --port 8073

Trust model: no authentication - it binds to your LAN/hotspot, which is
protected by the hotspot's WPA2 password. Don't port-forward it to the internet.
"""

import argparse
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import shutil
import socket
import sqlite3
import subprocess
import threading
import time
import xml.etree.ElementTree as ET
from contextlib import redirect_stdout
from datetime import datetime, timezone
from types import SimpleNamespace

from flask import Flask, Response, jsonify, request, send_from_directory

STATIC_DIR = os.environ.get("HAMPI_DASH_STATIC", "/usr/local/share/hampi-dash")
TOOLS_DIR = os.environ.get("HAMPI_TOOLS_DIR", "/usr/local/bin")
DB_DIR = os.environ.get("HAMPI_DB_DIR", "/var/lib/hampi")
POWER_CSV = os.environ.get("HAMPI_POWER_CSV", "/var/log/hampi/power.csv")

app = Flask(__name__, static_folder=None)

# ---------------------------------------------------------------------------
# Reuse the hampi-* CLI tools as libraries
# ---------------------------------------------------------------------------

_tools = {}


def load_tool(fname):
    if fname in _tools:
        return _tools[fname]
    path = os.path.join(TOOLS_DIR, fname)
    modname = fname.replace("-", "_")
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(modname, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _tools[fname] = mod
    return mod


def capture(fn, *a, **kw):
    """Run a print-style function and return what it printed."""
    buf = io.StringIO()
    with redirect_stdout(buf):
        fn(*a, **kw)
    return buf.getvalue()


def err(msg, code=503):
    return jsonify({"error": str(msg)}), code


# ---------------------------------------------------------------------------
# Cached hardware probes (keep /api/status fast)
# ---------------------------------------------------------------------------

_cache = {}
_cache_lock = threading.Lock()


def cached(key, ttl, fn):
    now = time.monotonic()
    with _cache_lock:
        hit = _cache.get(key)
        if hit and now - hit[0] < ttl:
            return hit[1]
    val = fn()
    with _cache_lock:
        _cache[key] = (now, val)
    return val


def probe_keyboards():
    """Physical (USB/Bluetooth) keyboards currently attached."""
    names = []
    try:
        blocks = open("/proc/bus/input/devices").read().split("\n\n")
    except OSError:
        return names
    for b in blocks:
        if "kbd" not in b:
            continue
        m = re.search(r'N: Name="([^"]+)"', b)
        ev = re.search(r"B: EV=([0-9a-f]+)", b)
        if not (m and ev):
            continue
        evbits = int(ev.group(1), 16)
        name = m.group(1)
        # Real keyboards report key events (0x2) with auto-repeat (0x100000);
        # skip the Pi's own pseudo-devices.
        if evbits & 0x2 and evbits & 0x100000 and not any(
                s in name.lower() for s in ("gpio", "vc4", "hdmi", "virtual")):
            names.append(name)
    return names


def probe_gps():
    if not shutil.which("gpspipe"):
        return {"state": "no-gpsd"}
    try:
        out = subprocess.run(["gpspipe", "-w", "-n", "6"], capture_output=True,
                             text=True, timeout=4).stdout
    except Exception:
        return {"state": "no-fix"}
    for line in out.splitlines():
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        if msg.get("class") == "TPV" and msg.get("mode", 0) >= 2:
            return {"state": "fix", "mode": msg["mode"], "lat": msg.get("lat"),
                    "lon": msg.get("lon"), "alt": msg.get("alt"),
                    "speed": msg.get("speed"), "time": msg.get("time")}
    return {"state": "no-fix"}


def probe_timesync():
    try:
        out = subprocess.run(["timedatectl", "show", "-p", "NTPSynchronized",
                              "--value"], capture_output=True, text=True,
                             timeout=3).stdout.strip()
        return out == "yes"
    except Exception:
        return None


