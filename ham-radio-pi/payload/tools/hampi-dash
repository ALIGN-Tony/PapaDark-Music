@app.get("/api/status")
def api_status():
    now = datetime.now(timezone.utc)
    try:
        uptime = float(open("/proc/uptime").read().split()[0])
    except OSError:
        uptime = None
    temp = None
    try:
        temp = int(open("/sys/class/thermal/thermal_zone0/temp").read()) / 1000
    except OSError:
        pass
    du = shutil.disk_usage("/")
    try:
        ips = subprocess.run(["hostname", "-I"], capture_output=True, text=True,
                             timeout=3).stdout.split()
    except Exception:
        ips = []
    kbs = cached("kb", 5, probe_keyboards)
    try:
        callsign = load_tool("hampi-wx").station_conf().get("CALLSIGN", "")
    except Exception:
        callsign = ""
    return jsonify({
        "callsign": callsign,
        "callsign_db": cached("csdb", 60, callsign_db_info),
        "license": license_status(),
        "utc": now.strftime("%Y-%m-%d %H:%M:%S"),
        "hostname": socket.gethostname(),
        "uptime_s": uptime,
        "cpu_temp_c": temp,
        "disk_free_gb": round(du.free / 1e9, 1),
        "ips": ips,
        "keyboards": kbs,
        "physical_keyboard": bool(kbs),
        "time_synced": cached("sync", 30, probe_timesync),
        "gps": cached("gps", 20, probe_gps),
    })


