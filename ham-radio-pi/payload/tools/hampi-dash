# ---------------------------------------------------------------------------
# Rig control bridge (rigctld on localhost:4532)
# ---------------------------------------------------------------------------

def rig_cmd(cmd, reply_lines=1):
    with socket.create_connection(("127.0.0.1", 4532), timeout=2) as s:
        f = s.makefile("rw", newline="\n")
        f.write(cmd + "\n")
        f.flush()
        out = []
        for _ in range(reply_lines):
            line = f.readline().strip()
            out.append(line)
            if line.startswith("RPRT"):
                break
        return out


@app.get("/api/rig")
def api_rig():
    try:
        freq = rig_cmd("f")[0]
        mode = rig_cmd("m", 2)
        if freq.startswith("RPRT"):
            return err(f"rigctld error {freq}")
        return jsonify({"freq_hz": int(freq), "mode": mode[0],
                        "passband": mode[1] if len(mode) > 1 else None})
    except (OSError, ValueError) as e:
        return err(f"rigctld not reachable on localhost:4532 ({e}). "
                   "Start it: rigctld -m <model> -r /dev/ttyUSB0 &")


@app.post("/api/rig")
def api_rig_set():
    body = request.get_json(silent=True) or {}
    try:
        if "freq_hz" in body:
            r = rig_cmd(f"F {int(body['freq_hz'])}")[0]
        elif "mode" in body:
            mode = re.sub(r"[^A-Za-z]", "", str(body["mode"]))[:8].upper()
            r = rig_cmd(f"M {mode} -1")[0]
        else:
            return err("body needs freq_hz or mode", 400)
        ok = r == "RPRT 0"
        return jsonify({"ok": ok, "reply": r}), (200 if ok else 502)
    except (OSError, ValueError) as e:
        return err(f"rigctld not reachable ({e})")


# ---------------------------------------------------------------------------
# Logbook (SQLite + ADIF export)
# ---------------------------------------------------------------------------

def db():
    os.makedirs(DB_DIR, exist_ok=True)
    conn = sqlite3.connect(os.path.join(DB_DIR, "logbook.sqlite"))
    conn.row_factory = sqlite3.Row
    conn.execute("""CREATE TABLE IF NOT EXISTS qsos (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts_utc TEXT NOT NULL,
        call TEXT NOT NULL,
        freq_mhz REAL, mode TEXT, rst_sent TEXT, rst_rcvd TEXT,
        name TEXT, qth TEXT, grid TEXT, notes TEXT)""")
    # Activation columns (added to existing DBs by migration below).
    for col in ("act_sig TEXT", "act_ref TEXT", "their_ref TEXT"):
        try:
            conn.execute(f"ALTER TABLE qsos ADD COLUMN {col}")
        except sqlite3.OperationalError:
            pass  # column already exists
    return conn


@app.get("/api/log")
def api_log_list():
    q = request.args.get("q", "").strip()
    limit = min(int(request.args.get("limit", 50)), 500)
    conn = db()
    if q:
        like = f"%{q}%"
        rows = conn.execute(
            "SELECT * FROM qsos WHERE call LIKE ? OR name LIKE ? OR notes LIKE ?"
            " ORDER BY id DESC LIMIT ?", (like, like, like, limit)).fetchall()
    else:
        rows = conn.execute("SELECT * FROM qsos ORDER BY id DESC LIMIT ?",
                            (limit,)).fetchall()
    total = conn.execute("SELECT COUNT(*) c FROM qsos").fetchone()["c"]
    conn.close()
    return jsonify({"total": total, "qsos": [dict(r) for r in rows]})


@app.post("/api/log")
def api_log_add():
    b = request.get_json(silent=True) or {}
    call = str(b.get("call", "")).strip().upper()
    if not call:
        return err("call is required", 400)
    ts = str(b.get("ts_utc") or
             datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"))
    freq = b.get("freq_mhz")
    try:
        freq = float(freq) if freq not in (None, "") else None
    except ValueError:
        return err("freq_mhz must be a number", 400)
    fields = {k: str(b.get(k, "")).strip()[:120]
              for k in ("mode", "rst_sent", "rst_rcvd", "name", "qth", "grid")}
    notes = str(b.get("notes", "")).strip()[:1000]
    conn = db()
    cur = conn.execute(
        "INSERT INTO qsos (ts_utc,call,freq_mhz,mode,rst_sent,rst_rcvd,name,qth,grid,notes)"
        " VALUES (?,?,?,?,?,?,?,?,?,?)",
        (ts, call, freq, fields["mode"].upper(), fields["rst_sent"],
         fields["rst_rcvd"], fields["name"], fields["qth"],
         fields["grid"].upper(), notes))
    conn.commit()
    qso_id = cur.lastrowid
    conn.close()
    return jsonify({"ok": True, "id": qso_id})


@app.delete("/api/log/<int:qso_id>")
def api_log_delete(qso_id):
    conn = db()
    n = conn.execute("DELETE FROM qsos WHERE id=?", (qso_id,)).rowcount
    conn.commit()
    conn.close()
    return jsonify({"ok": n == 1})


def adif_field(name, value):
    if value in (None, ""):
        return ""
    s = str(value)
    return f"<{name}:{len(s)}>{s}"


@app.get("/api/log/export.adi")
def api_log_adif():
    conn = db()
    rows = conn.execute("SELECT * FROM qsos ORDER BY id").fetchall()
    conn.close()
    out = ["HamPi logbook ADIF export",
           adif_field("ADIF_VER", "3.1.4") + adif_field("PROGRAMID", "HamPi")
           + " <EOH>"]
    for r in rows:
        try:
            dt = datetime.strptime(r["ts_utc"], "%Y-%m-%d %H:%M:%S")
        except ValueError:
            dt = None
        rec = (adif_field("CALL", r["call"])
               + (adif_field("QSO_DATE", dt.strftime("%Y%m%d")) if dt else "")
               + (adif_field("TIME_ON", dt.strftime("%H%M%S")) if dt else "")
               + adif_field("FREQ", r["freq_mhz"])
               + adif_field("MODE", r["mode"])
               + adif_field("RST_SENT", r["rst_sent"])
               + adif_field("RST_RCVD", r["rst_rcvd"])
               + adif_field("NAME", r["name"])
               + adif_field("QTH", r["qth"])
               + adif_field("GRIDSQUARE", r["grid"])
               + adif_field("COMMENT", r["notes"])
               + " <EOR>")
        out.append(rec)
    return Response("\n".join(out) + "\n", mimetype="text/plain",
                    headers={"Content-Disposition":
                             "attachment; filename=hampi-logbook.adi"})


# ---------------------------------------------------------------------------
# POTA / SOTA Activation Mode
#
# Run an activation from the field: set your park/summit reference, log QSOs
# tagged with it, and watch the count climb toward a valid activation. POTA
# needs 10 QSOs (unique per band+mode+UTC-day); SOTA needs 4 unique callsigns.
# Park-to-Park / Summit-to-Summit contacts are tracked separately. Exports in
# POTA-flavored ADIF and SOTA CSV v2. All offline; upload when internet returns.
# ---------------------------------------------------------------------------

ACT_PATH = os.path.join(DB_DIR, "activation.json")

PROGRAMS = {
    "POTA": {"threshold": 10, "unit": "band_mode", "place": "park",
             "s2s": "P2P", "s2s_long": "Park-to-Park"},
    "SOTA": {"threshold": 4, "unit": "call", "place": "summit",
             "s2s": "S2S", "s2s_long": "Summit-to-Summit"},
}


def band_from_mhz(mhz):
    try:
        return band_name(float(mhz) * 1e6)
    except (TypeError, ValueError):
        return ""


def load_activation():
    try:
        with open(ACT_PATH) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def save_activation(sess):
    os.makedirs(DB_DIR, exist_ok=True)
    if sess is None:
        try:
            os.remove(ACT_PATH)
        except OSError:
            pass
    else:
        with open(ACT_PATH, "w") as fh:
            json.dump(sess, fh)


def activation_rows(sess):
    conn = db()
    try:
        return conn.execute(
            "SELECT id, ts_utc, call, freq_mhz, mode, rst_sent, rst_rcvd, "
            "their_ref FROM qsos WHERE act_sig=? AND act_ref=? AND ts_utc>=? "
            "ORDER BY id", (sess["program"], sess["ref"], sess["started_str"])
        ).fetchall()
    finally:
        conn.close()


def qso_key(prog, call, mhz, mode):
    if prog["unit"] == "call":
        return call.upper()
    return (call.upper(), band_from_mhz(mhz), (mode or "").upper())


def activation_stats(sess):
    prog = PROGRAMS[sess["program"]]
    rows = activation_rows(sess)
    seen, valid, p2p = set(), 0, 0
    for r in rows:
        k = qso_key(prog, r["call"], r["freq_mhz"], r["mode"])
        if k not in seen:
            seen.add(k)
            valid += 1
        if r["their_ref"]:
            p2p += 1
    return {"total": len(rows), "valid": valid, "p2p": p2p,
            "threshold": prog["threshold"], "remaining": max(0, prog["threshold"] - valid),
            "activated": valid >= prog["threshold"], "s2s": prog["s2s"],
            "s2s_long": prog["s2s_long"], "place": prog["place"]}


def activation_payload():
    sess = load_activation()
    if not sess:
        return {"active": False, "programs": {k: {"threshold": v["threshold"],
                "place": v["place"], "s2s": v["s2s"]} for k, v in PROGRAMS.items()}}
    return {"active": True, "session": sess, "stats": activation_stats(sess),
            "recent": [dict(r) for r in activation_rows(sess)[-12:]]}


@app.get("/api/activation")
def api_activation():
    return jsonify(activation_payload())


@app.post("/api/activation/start")
def api_activation_start():
    b = request.get_json(silent=True) or {}
    program = str(b.get("program", "")).upper()
    if program not in PROGRAMS:
        return err("program must be POTA or SOTA", 400)
    ref = re.sub(r"\s+", "", str(b.get("ref", ""))).upper()
    if not ref:
        return err(f"a {PROGRAMS[program]['place']} reference is required", 400)
    call = str(b.get("call", "")).strip().upper()
    if not call:
        try:
            call = load_tool("hampi-wx").station_conf().get("CALLSIGN", "").upper()
        except Exception:
            call = ""
    now = datetime.now(timezone.utc)
    sess = {"program": program, "ref": ref, "call": call,
            "started": int(now.timestamp()),
            "started_str": now.strftime("%Y-%m-%d %H:%M:%S")}
    save_activation(sess)
    return jsonify({"ok": True, **activation_payload()})


@app.post("/api/activation/stop")
def api_activation_stop():
    save_activation(None)
    return jsonify({"ok": True, "active": False})


@app.post("/api/activation/qso")
def api_activation_qso():
    sess = load_activation()
    if not sess:
        return err("no activation in progress", 409)
    prog = PROGRAMS[sess["program"]]
    b = request.get_json(silent=True) or {}
    call = str(b.get("call", "")).strip().upper()
    if not call:
        return err("call is required", 400)
    try:
        mhz = float(b["freq_mhz"]) if b.get("freq_mhz") not in (None, "") else None
    except ValueError:
        return err("freq_mhz must be a number", 400)
    mode = str(b.get("mode", "")).strip().upper()[:12]
    their_ref = re.sub(r"\s+", "", str(b.get("their_ref", ""))).upper() or None

    # Is this a new contact for activation credit, before we insert it?
    existing = {qso_key(prog, r["call"], r["freq_mhz"], r["mode"])
                for r in activation_rows(sess)}
    is_new = qso_key(prog, call, mhz, mode) not in existing

    ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S")
    note = f"{sess['program']} {sess['ref']}" + (f" {prog['s2s']} {their_ref}" if their_ref else "")
    conn = db()
    conn.execute(
        "INSERT INTO qsos (ts_utc,call,freq_mhz,mode,rst_sent,rst_rcvd,name,qth,"
        "grid,notes,act_sig,act_ref,their_ref) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (ts, call, mhz, mode, str(b.get("rst_sent", "")).strip()[:10],
         str(b.get("rst_rcvd", "")).strip()[:10], "", "", "", note,
         sess["program"], sess["ref"], their_ref))
    conn.commit()
    conn.close()
    status = "p2p" if their_ref else ("new" if is_new else "dupe")
    return jsonify({"ok": True, "status": status, "stats": activation_stats(sess)})


def _act_qsos_or_404():
