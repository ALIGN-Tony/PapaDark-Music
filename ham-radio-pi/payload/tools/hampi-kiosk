#!/bin/bash
#
# Open the HamPi dashboard full-screen on the local display (RasPad/tablet).
#   hampi-kiosk            app window, maximized (Esc-friendly)
#   hampi-kiosk --kiosk    locked kiosk mode (exit with Alt+F4 / a keyboard)

set -u

URL="http://localhost:8073"

BROWSER=""
for b in chromium-browser chromium firefox; do
    command -v "$b" >/dev/null && { BROWSER=$b; break; }
done
[ -n "$BROWSER" ] || { echo "No browser found (install chromium-browser)." >&2; exit 1; }

# Give hampi-dash.service a moment on fresh boots.
for _ in $(seq 1 20); do
    curl -fsS -o /dev/null "$URL/api/status" && break
    sleep 1
done

case "$BROWSER" in
    firefox)
        exec firefox --kiosk "$URL"
        ;;
    *)
        FLAGS=(--app="$URL" --start-maximized --noerrdialogs
               --disable-session-crashed-bubble --disable-translate)
        [ "${1:-}" = "--kiosk" ] && FLAGS=(--kiosk "$URL" --noerrdialogs
               --disable-session-crashed-bubble)
        exec "$BROWSER" "${FLAGS[@]}"
        ;;
esac
